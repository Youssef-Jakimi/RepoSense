# Personal Access Token for GitHub API (optional for public repos, required for private)
GITHUB_TOKEN=

# IBM watsonx.ai credentials — from watsonx.ai home page → Developer access section
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model to use (default is fine, can swap to granite-3-8b-instruct for larger context)
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# Local directory where ChromaDB persists vector data
CHROMA_PERSIST_DIR=./chroma_db
